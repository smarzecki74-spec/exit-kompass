{
  "name": "exit-kompass",
  "version": "1.0.0",
  "description": "Landingpage EXIT-KOMPASS.de – Lead-Generierung für E-Book per WhatsApp",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src/input.css -o public/assets/styles.css --minify",
    "dev": "tailwindcss -c tailwind.config.js -i src/input.css -o public/assets/styles.css --watch",
    "icons": "node scripts/build-icons.mjs",
    "serve": "npx serve public",
    "cms:hash": "node scripts/cms-hash.mjs",
    "cms:dev": "npx wrangler pages dev public --port 8788"
  },
  "devDependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "lucide-static": "^1.59.0",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
