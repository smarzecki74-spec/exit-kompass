// Cloudflare Worker: statische Seite (public/) + Inhalte aus Supabase + CMS-API (/api/*)
// Geheimnisse (CMS_USERS, CMS_SECRET, GITHUB_TOKEN, SUPABASE_SECRET_KEY) werden im Dashboard gesetzt,
// nicht hier – siehe README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exit-kompass",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/content.json", "/impressum*", "/datenschutz*"]
  },
  // Öffentliche Supabase-Werte (durch Row Level Security abgesichert: nur Leads anlegen,
  // veröffentlichten Inhalt lesen). Der Secret Key gehört NICHT hierher.
  "vars": {
    "SUPABASE_URL": "https://zgxejffscdpksaoedtkg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Zq1-EjhV2IZkul1OfJE2vA_BLP1JOPe"
  },
  "observability": { "enabled": true },
  // Dashboard-Variablen bei jedem Deploy behalten
  "keep_vars": true
}
