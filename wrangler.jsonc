// Cloudflare Worker: statische Seite (public/) + CMS-API (/api/*)
// Variablen/Geheimnisse (CMS_USERS, CMS_SECRET, GITHUB_TOKEN) werden im Dashboard gesetzt,
// nicht hier – siehe README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exit-kompass",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/impressum*", "/datenschutz*"]
  },
  "observability": { "enabled": true },
  // Dashboard-Variablen bei jedem Deploy behalten
  "keep_vars": true
}
